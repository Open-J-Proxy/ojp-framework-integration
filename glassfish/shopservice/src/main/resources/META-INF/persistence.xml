<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!--
        JTA persistence unit for deployment on GlassFish.
        The JNDI datasource 'jdbc/shopservice' is defined in WEB-INF/glassfish-resources.xml
        and is created by GlassFish during deployment.
    -->
    <persistence-unit name="shopservice" transaction-type="JTA">
        <jta-data-source>jdbc/shopservice</jta-data-source>

        <class>com.example.shopservice.entity.User</class>
        <class>com.example.shopservice.entity.Product</class>
        <class>com.example.shopservice.entity.Order</class>
        <class>com.example.shopservice.entity.OrderItem</class>
        <class>com.example.shopservice.entity.Review</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <!-- Auto-create schema on first deployment -->
            <property name="jakarta.persistence.schema-generation.database.action" value="create"/>
            <property name="eclipselink.logging.level.sql" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="true"/>
        </properties>
    </persistence-unit>

</persistence>

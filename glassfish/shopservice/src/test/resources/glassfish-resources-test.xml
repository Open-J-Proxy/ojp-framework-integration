<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE resources PUBLIC
    "-//GlassFish.org//DTD GlassFish Application Server 3.1 Resource Definitions//EN"
    "http://glassfish.org/dtds/glassfish-resources_1_5.dtd">

<!--
    Test datasource using H2 in-memory database via the OJP proxy driver.
    The OJP URL format routes through a local OJP server (localhost:1059) before
    delegating to H2. Both the OJP driver jar and the H2 jar must be on the
    classpath (configured as test-scoped Maven dependencies).

    res-type="javax.sql.DataSource" is required for GlassFish JTA: the deployment
    validator looks up jdbc/shopservice as javax.sql.DataSource and fails if the
    resource is registered under java.sql.Driver type.  OjpDriverDataSource is a
    minimal DataSource adapter that delegates getConnection() to DriverManager so
    that the underlying OJP java.sql.Driver is used while satisfying GlassFish's
    DataSource requirement.

    Client-side connection pooling is disabled (steady-pool-size="0",
    max-connection-usage-count="1") because OJP handles all pooling on the proxy
    side. See WEB-INF/glassfish-resources.xml for full explanation.
-->
<resources>

    <jdbc-connection-pool
        name="ShopServicePool"
        res-type="javax.sql.DataSource"
        datasource-classname="com.example.shopservice.OjpDriverDataSource"
        steady-pool-size="0"
        idle-timeout-in-seconds="0"
        max-connection-usage-count="1">
        <!--
            Port 1059 is the conventional OJP test server port used across all framework
            integrations in this repository (Spring Boot, Micronaut, Quarkus, and GlassFish).
            OJP URL format: jdbc:ojp[<ojp-host>:<ojp-port>]_<backend-jdbc-url>
        -->
        <property name="url"
                  value="jdbc:ojp[localhost:1059]_h2:mem:shopdb;DB_CLOSE_DELAY=-1;DB_CLOSE_ON_EXIT=FALSE"/>
        <property name="user" value="sa"/>
        <property name="password" value=""/>
    </jdbc-connection-pool>

    <jdbc-resource
        jndi-name="jdbc/shopservice"
        pool-name="ShopServicePool"/>

</resources>

<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!--
        Test persistence unit using H2 in-memory database (direct connection, no OJP proxy).
        'drop-and-create' ensures a clean schema before each test deployment.
    -->
    <persistence-unit name="shopservice" transaction-type="JTA">
        <!--
            Use the java:app/ prefix to match the @DataSourceDefinition registered by
            TestDataSourceProducer.  Plain "jdbc/shopservice" cannot be used in embedded
            GlassFish tests because the glassfish-resources.xml jdbc-resource is not bound
            in JNDI before ResourceValidator.validateJNDIRefs runs.
        -->
        <jta-data-source>java:app/jdbc/shopservice</jta-data-source>

        <class>com.example.shopservice.entity.User</class>
        <class>com.example.shopservice.entity.Product</class>
        <class>com.example.shopservice.entity.Order</class>
        <class>com.example.shopservice.entity.OrderItem</class>
        <class>com.example.shopservice.entity.Review</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <!--
                EclipseLink's auto-generated DROP order does not always respect FK constraints
                (e.g. it tries to DROP products before order_items which references it).
                H2 rejects the constrained DROP silently; EclipseLink then skips the table and
                proceeds to CREATE, which fails with "table already exists" on a second run.
                Using an explicit drop script with FK-safe ordering (children first) avoids this.
            -->
            <property name="jakarta.persistence.schema-generation.drop-source" value="script"/>
            <property name="jakarta.persistence.schema-generation.drop-script-source" value="META-INF/drop.sql"/>
            <!--
                Use explicit SQL scripts for schema creation.  The entities use
                GenerationType.SEQUENCE so EclipseLink calls NEXTVAL before each INSERT
                and includes the ID in the statement.  This avoids the OJP proxy limitation
                where IDENTITY/auto-increment semantics are stripped from DDL statements,
                which caused "NULL not allowed for column ID" errors with IDENTITY columns.
            -->
            <property name="jakarta.persistence.schema-generation.create-source" value="script"/>
            <property name="jakarta.persistence.schema-generation.create-script-source" value="META-INF/create.sql"/>
            <!--
                Tell EclipseLink we are talking to H2 so it maps types correctly.
                Use the fully qualified class name — EclipseLink 4.x does not resolve
                the short alias "H2" and throws ClassNotFoundException otherwise.
            -->
            <property name="eclipselink.target-database" value="org.eclipse.persistence.platform.database.H2Platform"/>
            <!--
                Disable EclipseLink's proprietary DDL generation entirely.
                The JPA standard drop-source=script and create-source=script below
                are independent of this setting and still execute drop.sql/create.sql.
                Without this, EclipseLink's metadata-based DDL races with the JPA
                standard scripts and creates tables with "BIGINT IDENTITY" (which the
                OJP gRPC proxy strips, leaving plain NOT NULL columns with no default).
            -->
            <property name="eclipselink.ddl-generation" value="none"/>
            <property name="eclipselink.logging.level.sql" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="true"/>
        </properties>
    </persistence-unit>

</persistence>

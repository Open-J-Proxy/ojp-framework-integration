<?xml version="1.0" encoding="UTF-8"?>
<persistence xmlns="https://jakarta.ee/xml/ns/persistence"
             xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
             xsi:schemaLocation="https://jakarta.ee/xml/ns/persistence
                 https://jakarta.ee/xml/ns/persistence/persistence_3_0.xsd"
             version="3.0">

    <!--
        Test persistence unit using H2 in-memory database via OJP proxy.
        'drop-and-create' ensures a clean schema before each test deployment.
    -->
    <persistence-unit name="shopservice" transaction-type="JTA">
        <jta-data-source>jdbc/shopservice</jta-data-source>

        <class>com.example.shopservice.entity.User</class>
        <class>com.example.shopservice.entity.Product</class>
        <class>com.example.shopservice.entity.Order</class>
        <class>com.example.shopservice.entity.OrderItem</class>
        <class>com.example.shopservice.entity.Review</class>
        <exclude-unlisted-classes>true</exclude-unlisted-classes>

        <properties>
            <property name="jakarta.persistence.schema-generation.database.action" value="drop-and-create"/>
            <!--
                Tell EclipseLink we are talking to H2.  Without this hint EclipseLink auto-detects
                the database from JDBC metadata.  Because the OJP proxy sits between the application
                and H2, the metadata may not be recognised as H2 and EclipseLink falls back to a
                generic dialect that omits the GENERATED BY DEFAULT AS IDENTITY clause on @Id columns,
                causing every JPA persist() to fail with a NOT-NULL constraint violation.
                This mirrors the explicit dialect hints used in all other frameworks in this repo:
                  Spring Boot  → hibernate.dialect=org.hibernate.dialect.H2Dialect
                  Quarkus      → quarkus.datasource.db-kind=h2
            -->
            <property name="eclipselink.target-database" value="H2"/>
            <property name="eclipselink.logging.level.sql" value="FINE"/>
            <property name="eclipselink.logging.parameters" value="true"/>
        </properties>
    </persistence-unit>

</persistence>
